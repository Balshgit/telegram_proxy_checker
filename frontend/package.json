{
  "name": "telegram-proxy-checker-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config settings/vite.config.ts",
    "build": "tsc -b settings/tsconfig.json && vite build --config settings/vite.config.ts",
    "preview": "vite preview --config settings/vite.config.ts",
    "test": "vitest run --config settings/vite.config.ts",
    "test:watch": "vitest --config settings/vite.config.ts",
    "test:coverage": "vitest run --coverage --config settings/vite.config.ts",
    "typecheck": "tsc -b settings/tsconfig.json",
    "typecheck:test": "tsc -p settings/tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
